<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Replace YOUR_USERNAME with your macOS username before installing.

  Install:
    mkdir -p ~/.anito/logs
    cp com.anito.daemon.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.anito.daemon.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.anito.daemon.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.anito.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/anito</string>
    <string>daemon</string>
    <string>--port</string>
    <string>7700</string>
    <string>--mcp-port</string>
    <string>7701</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/.anito/logs/anito.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/.anito/logs/anito.error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/YOUR_USERNAME</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
